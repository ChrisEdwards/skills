#!/bin/zsh
# atts - speak agent output aloud through a resident Pocket TTS server.
#
#   atts "Done. Six tests pass."      speak text
#   echo "..." | atts                 speak stdin
#   atts --voice jean "..."           pick a voice
#   atts --seed 7 "..."               change the take (-1 for a random one each time)
#   atts --temp 0.4 "..."             steadier delivery, 0.7 is the model default
#   atts --speed 1.2 "..."            faster without raising pitch (0.5 to 3.0)
#   atts --raw "..."                  skip normalisation
#   atts --dry "..."                  print the normalised text, say nothing
#   atts --status / --stop / --voices
#
# Starts the server on first use and leaves it resident.

set -u
# Code lives beside this script (symlinks resolved). The venv and log are
# machine data and live in DATA_DIR.
SCRIPT_DIR=${0:A:h}
DATA_DIR=$HOME/.local/share/agent-tts
PY=$DATA_DIR/venv/bin/python
PORT=${AGENT_TTS_PORT:-7711}
BASE=http://127.0.0.1:$PORT
LOG=$DATA_DIR/server.log
VOICE=${AGENT_TTS_VOICE:-alba}
# Seed 99 picked by ear. Seed 42 was a close second, so try --seed 42 first
# if 99 starts to wear thin.
SEED=${AGENT_TTS_SEED:-99}
TEMP=${AGENT_TTS_TEMP:-0.7}
# Pocket TTS has no speed parameter, so this is a playback-side time stretch
# via ffmpeg atempo, which preserves pitch. 1.0 is the model's natural pace.
# 1.1 picked by ear on 2026-09-19. Past about 1.5 consonants start to clip.
SPEED=${AGENT_TTS_SPEED:-1.1}
NORMALIZE=true
DRY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --voice)  VOICE="$2"; shift 2 ;;
    --seed)   SEED="$2"; shift 2 ;;
    --temp)   TEMP="$2"; shift 2 ;;
    --speed)  SPEED="$2"; shift 2 ;;
    --raw)    NORMALIZE=false; shift ;;
    --dry)    DRY=true; shift ;;
    --status)
      curl -s --max-time 2 $BASE/health && echo || echo "not running"
      exit 0 ;;
    --voices)
      echo "alba azelma cosette eponine fantine javert jean marius"
      exit 0 ;;
    --stop)
      # By port, not path, so it also stops a server started from elsewhere.
      PID=$(lsof -ti tcp:$PORT -sTCP:LISTEN)
      [[ -n "$PID" ]] && kill $PID && echo "stopped" || echo "was not running"
      exit 0 ;;
    --log)    tail -n 40 $LOG; exit 0 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
done

if [[ $# -gt 0 ]]; then TEXT="$*"; else TEXT=$(cat); fi
[[ -z "${TEXT// /}" ]] && exit 0

if [[ "$DRY" == true ]]; then
  print -r -- "$TEXT" | $PY $SCRIPT_DIR/normalize.py
  exit 0
fi

# Start the server if it is not answering.
if ! curl -s --max-time 2 $BASE/health >/dev/null 2>&1; then
  if [[ ! -x $PY ]]; then
    print -u2 "atts: no Python environment at $DATA_DIR/venv. See references/SETUP.md in the speak skill."
    exit 1
  fi
  nohup $PY $SCRIPT_DIR/server.py >>$LOG 2>&1 &
  READY=false
  for i in $(seq 1 60); do
    if curl -s --max-time 1 $BASE/health >/dev/null 2>&1; then READY=true; break; fi
    sleep 0.5
  done
  if [[ "$READY" != true ]]; then
    print -u2 "atts: server failed to start. Last log lines:"
    tail -n 15 $LOG >&2
    exit 1
  fi
fi

BODY=$($PY -c '
import json,sys
print(json.dumps({"text": sys.stdin.read(),
                  "voice": sys.argv[1],
                  "normalize": sys.argv[2] == "true",
                  "seed": int(sys.argv[3]),
                  "temperature": float(sys.argv[4])}))' \
  "$VOICE" "$NORMALIZE" "$SEED" "$TEMP" <<< "$TEXT")

# atempo only accepts 0.5 to 2.0 per instance, so chain it past that range.
AF_ARGS=()
if (( SPEED != 1.0 )); then
  if (( SPEED >= 0.5 && SPEED <= 2.0 )); then
    AF_ARGS=(-af "atempo=$SPEED")
  elif (( SPEED > 2.0 )); then
    AF_ARGS=(-af "atempo=2.0,atempo=$(( SPEED / 2.0 ))")
  else
    AF_ARGS=(-af "atempo=0.5,atempo=$(( SPEED / 0.5 ))")
  fi
fi

curl -s --no-buffer -X POST $BASE/say \
     -H 'Content-Type: application/json' \
     --data-binary "$BODY" \
  | ffplay -f s16le -ar 24000 -ch_layout mono -nodisp -autoexit \
           -loglevel quiet -probesize 4096 -analyzeduration 0 \
           -fflags nobuffer "${AF_ARGS[@]}" -i pipe:0
